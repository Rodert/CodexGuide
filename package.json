{
  "name": "codex-guide",
  "version": "0.1.0",
  "private": true,
  "description": "面向小白的 Codex 中文使用教程",
  "type": "module",
  "scripts": {
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "dev": "pnpm generate:sitemap && vuepress-vite dev src",
    "build": "pnpm generate:sitemap && vuepress-vite build src",
    "clean": "pnpm generate:sitemap && vuepress-vite dev src --clean-cache"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.130",
    "sass-embedded": "^1.99.0",
    "vue": "^3.5.34",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-hope": "2.0.0-rc.107"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
